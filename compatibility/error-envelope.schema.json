{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oca error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "code", "help"],
  "properties": {
    "error": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "help": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "type": "string"
    },
    "retry_after_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
